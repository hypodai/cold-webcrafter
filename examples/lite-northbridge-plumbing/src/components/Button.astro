---
const { href, variant = 'primary', class: cls = '' } = Astro.props;
const styles = {
  primary: 'bg-brand-700 text-white hover:bg-brand-800',
  light: 'bg-white text-brand-800 hover:bg-brand-50',
  ghost: 'border border-white/40 text-white hover:bg-white/10',
  outline: 'border border-brand-300 text-brand-800 hover:bg-brand-50',
}[variant];
---
<a href={href} class={`inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-lg px-5 py-3 text-base font-semibold transition duration-200 active:scale-[0.98] ${styles} ${cls}`}><slot /></a>
