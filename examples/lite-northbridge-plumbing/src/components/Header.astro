---
import site from '../../content/site.json';
import logo from '../assets/img/logo.gif';
import { Image } from 'astro:assets';
import Icon from './Icon.astro';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
---
<header class="sticky top-0 z-40 bg-brand-700 text-white shadow-md">
  <div class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-x-6 gap-y-1 px-4 py-2 sm:px-6">
    <a href="/" class="flex items-center gap-3" aria-label={`${site.name} — home`}>
      <Image src={logo} alt="" width={120} height={45} class="h-9 w-auto" loading="eager" />
      <span class="hidden font-serif text-lg font-semibold leading-tight sm:block">{site.name}</span>
    </a>
    <nav aria-label="Main" class="order-3 flex w-full gap-1 text-sm font-medium sm:order-none sm:w-auto sm:text-base">
      {site.nav.map((i) => (
        <a href={i.href} aria-current={path === i.href ? 'page' : undefined} class={`rounded-md px-3 py-2 transition hover:bg-white/10 ${path === i.href ? 'bg-white/15' : ''}`}>{i.label}</a>
      ))}
    </nav>
    <a href={`tel:${site.phone_href}`} class="inline-flex items-center gap-2 whitespace-nowrap rounded-lg bg-white px-3.5 py-2 text-sm font-semibold text-brand-800 transition hover:bg-brand-50 active:scale-[0.98] sm:text-base">
      <Icon name="phone" class="h-4 w-4" /> {site.phone}
    </a>
  </div>
</header>
