---
const { d } = Astro.props;
const cols = { 1: 'sm:grid-cols-1', 2: 'sm:grid-cols-2', 3: 'sm:grid-cols-3', 4: 'sm:grid-cols-4' }[d.items.length];
---
<section class="border-b border-line bg-paper">
  <dl class={`mx-auto grid max-w-6xl gap-6 px-4 py-10 sm:px-6 ${cols}`}>
    {d.items.map((s, i) => (
      <div class="text-center sm:text-left" data-reveal style={`--d:${i * 90}ms`}>
        <dt class="font-serif text-5xl font-semibold leading-none text-brand-700">{s.number}{s.suffix}</dt>
        <dd class="mt-2 text-muted">{s.label}</dd>
      </div>
    ))}
  </dl>
</section>
